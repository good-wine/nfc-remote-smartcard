{
  "manifest_version": 3,
  "name": "NFC Smartcard Remote",
  "version": "0.3.0",
  "description": "Login PA/CIE e firma via smartphone NFC (Firefox MV3).",
  "browser_specific_settings": { "gecko": { "id": "nfc-remote@example.it", "strict_min_version": "128.0" } },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "background": { "scripts": ["src/background/service-worker.js"], "type": "module" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png" },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://nfc.local:8443/*", "http://127.0.0.1:8080/*"],
  "content_scripts": [
    {
      "matches": ["https://*.gov.it/*"],
      "js": ["src/content/content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
