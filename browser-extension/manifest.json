{
  "manifest_version": 3,
  "name": "NFC Smartcard Remote",
  "version": "0.3.0",
  "description": "Login PA/CIE e firma via smartphone NFC. Engine su https://nfc.local:8443 (fallback 127.0.0.1:8080).",
  "minimum_chrome_version": "131",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "src/popup/popup.html" },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "activeTab", "scripting", "alarms", "sidePanel"],
  "host_permissions": ["https://nfc.local:8443/*", "wss://nfc.local:8443/*", "http://127.0.0.1:8080/*", "ws://127.0.0.1:8080/*"],
  "optional_host_permissions": ["https://*.gov.it/*", "https://*.spid.gov.it/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src wss://nfc.local:8443 https://nfc.local:8443 ws://127.0.0.1:8080 http://127.0.0.1:8080"
  },
  "content_scripts": [
    {
      "matches": ["https://*.spid.gov.it/*", "https://*.interno.gov.it/*", "https://*.gov.it/*"],
      "js": ["src/content/content-bridge.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.spid.gov.it/*", "https://*.interno.gov.it/*", "https://*.gov.it/*"],
      "js": ["src/content/injected.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
