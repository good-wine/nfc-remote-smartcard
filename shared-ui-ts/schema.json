{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NFC Extension Wire",
  "definitions": {
    "transmit_apdu": {
      "type": "object",
      "required": ["type", "request_id", "payload_hex"],
      "properties": {
        "type": { "const": "transmit_apdu" },
        "request_id": { "type": "string", "minLength": 1 },
        "payload_hex": { "type": "string", "minLength": 8 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 30000, "default": 8000 }
      },
      "additionalProperties": false
    },
    "apdu_reply": {
      "type": "object",
      "required": ["type", "request_id", "data_hex", "sw1", "sw2", "latency_ms"],
      "properties": {
        "type": { "const": "apdu_reply" },
        "request_id": { "type": "string" },
        "data_hex": { "type": "string" },
        "sw1": { "type": "integer", "minimum": 0, "maximum": 255 },
        "sw2": { "type": "integer", "minimum": 0, "maximum": 255 },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
