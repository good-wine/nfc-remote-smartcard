{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFC Smartcard Remote",
  "version": "0.3.0",
  "identifier": "it.nfcremote.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NFC Smartcard Remote",
        "width": 620,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss://nfc.local:8443 https://nfc.local:8443 ws://127.0.0.1:8080 http://127.0.0.1:8080; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Smartphone come lettore smartcard NFC remoto (PC/SC virtuale, E2EE ibrida PQ)",
    "longDescription": "Engine Rust Axum: vpcd TCP 35963, WS/REST 8080, E2EE X25519+ML-KEM-768/AES-GCM, mDNS, tray + headless, updater firmato.",
    "createUpdaterArtifacts": true,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "13.0",
      "signingIdentity": null
    },
    "linux": {
      "deb": { "depends": ["libpcsclite1"] },
      "appimage": { "bundleMediaFramework": true }
    },
    "resources": ["resources/vpcd-config.json"]
  },
  "plugins": {
    "updater": { "endpoints": [], "pubkey": "TODO-BASE64-MINISIGN-PUBKEY" }
  }
}
