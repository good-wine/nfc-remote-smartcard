{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NFC Remote Mobile",
  "version": "0.3.0",
  "identifier": "it.nfcremote.mobile",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss://nfc.local:8443 https://nfc.local:8443 ws://127.0.0.1:8080 http://127.0.0.1:8080; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
